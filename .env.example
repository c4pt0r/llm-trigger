# 全部可选。不设就用当前 pi 会话的模型和默认端口。

# Agent backend for compiling and judging. pi is just one example agent.
# Preset name (pi | claude) or a path to a JSON config:
#   { "cmd": "my-agent", "args": ["--system", "{system}", "{user}"], "output": "text" }
#LT_AGENT=pi

# Model for the agent (provider/id for pi). Defaults to $PI_PROVIDER/$PI_MODEL,
# then falls back to strata/qwen3.8-flash-next-iq3_s
#LT_MODEL=strata/qwen3.8-flash-next-iq3_s

PI_BIN=pi
LT_DB=./data/llm-trigger.db
PORT=8787
HOST=127.0.0.1

# off = 只跑 API/网页，不起调度器
LT_SCHEDULER=on

# 调度器 tick 间隔（毫秒，默认 60000）。cron 粒度是分钟，调小无意义；
# 调大也不会漏检查（due-window 会补上跳过的分钟）
#LT_TICK_MS=60000

# 句子里没说频率时规则的默认轮询 cron（UTC，默认每 10 分钟）
#LT_EVERY=*/10 * * * *

# 允许 shell.exec 动作（默认关闭）
#ALLOW_SHELL=1

# github 限流：60 req/h（未认证）
#GITHUB_TOKEN=
